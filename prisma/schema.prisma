datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────

enum UserRole {
  VIEWER   // read-only
  MEMBER   // full task/project access
  ADMIN    // full access + user management
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum SprintMode {
  FOCUS
  SHORT_BREAK
  LONG_BREAK
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

// ─────────────────────────────────────────────────────────────────
//  ACCESS MANAGEMENT
//  Controls who can sign in and what they can do.
//  Identity (email/password/OAuth) is managed by Neon Auth
//  in the separate `neon_auth` schema.
// ─────────────────────────────────────────────────────────────────

model AppUser {
  id        String   @id @default(cuid())
  email     String   @unique
  role      UserRole @default(MEMBER)
  note      String?
  createdAt DateTime @default(now())

  @@map("users")
}

// External API keys — let outside applications authenticate against the
// public API (`/api/v1/*`) with a Bearer token instead of a session cookie.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyPrefix  String                        // first chars, shown in UI for identification
  keyHash    String    @unique             // sha256 of the full secret; secret itself is never stored
  userId     String                        // neon_auth user id — acts as this user for API access
  email      String                        // resolves role (VIEWER/MEMBER/ADMIN) at request time
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────────
//  PROJECTS  (top-level workspace containers)
//  Project
//  └── ProjectMember  (who has access to this project)
//  └── Task[]         (see Tasks section)
// ─────────────────────────────────────────────────────────────────

model Project {
  id          String          @id @default(cuid())
  name        String
  color       String          @default("#06b6d4")
  description String?
  userId      String                        // owner (neon_auth user id)
  members     ProjectMember[]
  tasks       Task[]
  sprints     SprintSession[]
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String                              // neon_auth user id
  role      ProjectRole @default(EDITOR)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// ─────────────────────────────────────────────────────────────────
//  TASKS  (children of a Project)
//  Task
//  ├── TaskAssignee[]  (contributors on this task)
//  └── Subtask[]       (breakdown items)
// ─────────────────────────────────────────────────────────────────

model Task {
  id          String         @id @default(cuid())
  title       String
  description String?
  priority    Priority       @default(MEDIUM)
  status      TaskStatus     @default(TODO)
  startDate   DateTime?
  dueDate     DateTime?
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String                        // owner (neon_auth user id)
  assignees   TaskAssignee[]
  subtasks    Subtask[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([userId, projectId])
  @@index([userId, status])
  @@map("tasks")
}

model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  userId String                            // neon_auth user id
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model Subtask {
  id          String   @id @default(cuid())
  title       String
  description String?
  completed   Boolean  @default(false)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@map("subtasks")
}

// ─────────────────────────────────────────────────────────────────
//  TRACKING  (Pomodoro / focus session logs)
// ─────────────────────────────────────────────────────────────────

model SprintSession {
  id        String     @id @default(cuid())
  taskName  String?
  duration  Int                            // minutes
  mode      SprintMode @default(FOCUS)
  completed Boolean    @default(true)
  projectId String?
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId    String                         // neon_auth user id
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([projectId])
  @@map("sprint_sessions")
}

// ─────────────────────────────────────────────────────────────────
//  COMMAND CENTER  (chat sessions + messages)
//  userId is the Neon Auth user id (not AppUser.id).
//  Mapped off the public `sessions` name to avoid colliding with
//  neon_auth session tables.
// ─────────────────────────────────────────────────────────────────

model Session {
  id        String    @id @default(cuid())
  userId    String                         // neon_auth user id
  title     String    @default("New Intelligence Feed")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    String                         // "USER" | "SOLOMON"
  content   String   @db.Text
  command   String?                        // e.g. "/note" — null for plain chat
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
